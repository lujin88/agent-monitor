# Keep this local monitor's runtime data and credentials off GitHub.
/*
!/.gitignore
!/*.js
!/*.swift
!/*.sh
!/*.md
!/index.html
!/favicon.png
!/package.json
!/package-lock.json
# Exclude backups even when they have a source-file extension.
*backup*
*.log
*.json
!package.json
!package-lock.json
# Pixel Office prototype: a static page, its room config and images. Listed after *.json so its
# JSON is tracked; token.txt and .env* below still win inside this folder.
!/pixel-min/
!/pixel-min/**/*.json
/pixel-min/**/*backup*
token.txt
.env*
node_modules/
*.app/
screenshots/
